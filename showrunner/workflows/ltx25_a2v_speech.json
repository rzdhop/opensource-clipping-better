{
  "$schema": "comfy_workflow_v1",
  "name": "ltx25_a2v_speech",
  "task": "a2v_speech",
  "core_nodes_only": true,
  "verified_live": false,
  "description": "LTX-2.5 22B distilled int8 audio-to-video, two-stage: the uploaded line audio is trimmed to `seconds`, encoded by the audio VAE and frozen (noise mask 0) through both stages; the original waveform is muxed into the mp4. Sampler `euler` by default (the ancestral sampler and modality guidance are what the community reports as breaking lip-sync on 2.5, HF discussion #44); CFG 1. Authored from ComfyUI-LTXVideo 2.5/LTX-2.5_A2V_Two_Stage_Distilled.json (2026-10-08) with its API/enhancer switches removed: only core nodes of ComfyUI 0.34.0.",
  "placeholders": [
    "image",
    "audio",
    "prompt",
    "negative",
    "seed",
    "width",
    "height",
    "seconds",
    "fps",
    "sampler",
    "name"
  ],
  "files": {
    "image": "the keyframe (png)",
    "audio": "the line's audio (wav/mp3), uploaded like an image"
  },
  "derived": {
    "frames": "1 + floor(fps * seconds / 8) * 8",
    "half_width": "width / 2",
    "half_height": "height / 2",
    "last_index": "frames - 1",
    "seconds": "audio duration + 0.7 s tail, rounded up to the frame rule (set by the runner)"
  },
  "defaults": {
    "width": 704,
    "height": 1280,
    "fps": 24,
    "seconds": 5,
    "negative": "live action, real people, photograph, human skin, mask, costume, blurry, deformed mouth, extra limbs, text, subtitles, watermark, pc game, console game, video game, childish, ugly",
    "sampler": "euler"
  },
  "frame_rule": {
    "fps": 24,
    "frame_step": 8,
    "max_frames": 241,
    "lengths": [
      5,
      6,
      8,
      10
    ]
  },
  "requires": [
    {
      "node": "unet",
      "field": "unet_name",
      "file": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "dir": "models/diffusion_models"
    },
    {
      "node": "clip",
      "field": "clip_name",
      "file": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "dir": "models/text_encoders"
    },
    {
      "node": "vae",
      "field": "vae_name",
      "file": "ltx-2.5-video-vae-bf16.safetensors",
      "dir": "models/vae"
    },
    {
      "node": "avae",
      "field": "vae_name",
      "file": "ltx-2.5-audio-vae-bf16.safetensors",
      "dir": "models/vae"
    },
    {
      "node": "up_model",
      "field": "model_name",
      "file": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors",
      "dir": "models/latent_upscale_models"
    }
  ],
  "output_node": "save",
  "last_frame_node": "save_last",
  "graph": {
    "image": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image}}"
      }
    },
    "scale": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "image",
          0
        ],
        "upscale_method": "lanczos",
        "width": "{{width}}",
        "height": "{{height}}",
        "crop": "center"
      }
    },
    "prep": {
      "class_type": "LTXVPreprocess",
      "inputs": {
        "image": [
          "scale",
          0
        ],
        "img_compression": 18
      }
    },
    "unet": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
        "weight_dtype": "default"
      }
    },
    "vae": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
      }
    },
    "avae": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
      }
    },
    "clip": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
        "type": "ltxv",
        "device": "default"
      }
    },
    "up_model": {
      "class_type": "LatentUpscaleModelLoader",
      "inputs": {
        "model_name": "ltx-2.5-latent-spatial-upscaler-x2-bf16-1.0.safetensors"
      }
    },
    "pos": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "clip",
          0
        ]
      }
    },
    "neg": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "clip",
          0
        ]
      }
    },
    "cond": {
      "class_type": "LTXVConditioning",
      "inputs": {
        "positive": [
          "pos",
          0
        ],
        "negative": [
          "neg",
          0
        ],
        "frame_rate": "{{fps}}"
      }
    },
    "audio": {
      "class_type": "LoadAudio",
      "inputs": {
        "audio": "{{audio}}"
      }
    },
    "trim": {
      "class_type": "TrimAudioDuration",
      "inputs": {
        "audio": [
          "audio",
          0
        ],
        "start_index": 0.0,
        "duration": "{{seconds}}"
      }
    },
    "aenc": {
      "class_type": "LTXVAudioVAEEncode",
      "inputs": {
        "audio": [
          "trim",
          0
        ],
        "audio_vae": [
          "avae",
          0
        ]
      }
    },
    "mask": {
      "class_type": "SolidMask",
      "inputs": {
        "value": 0.0,
        "width": 1024,
        "height": 1024
      }
    },
    "frozen": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "aenc",
          0
        ],
        "mask": [
          "mask",
          0
        ]
      }
    },
    "lat1": {
      "class_type": "EmptyLTXVLatentVideo",
      "inputs": {
        "width": "{{half_width}}",
        "height": "{{half_height}}",
        "length": "{{frames}}",
        "batch_size": 1
      }
    },
    "i2v1": {
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": [
          "vae",
          0
        ],
        "image": [
          "prep",
          0
        ],
        "latent": [
          "lat1",
          0
        ],
        "strength": 0.7,
        "bypass": false
      }
    },
    "cat1": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "i2v1",
          0
        ],
        "audio_latent": [
          "frozen",
          0
        ]
      }
    },
    "guider1": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "unet",
          0
        ],
        "positive": [
          "cond",
          0
        ],
        "negative": [
          "cond",
          1
        ],
        "cfg": 1.0
      }
    },
    "noise1": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{{seed}}"
      }
    },
    "sampler": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "{{sampler}}"
      }
    },
    "sig1": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
      }
    },
    "s1": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise1",
          0
        ],
        "guider": [
          "guider1",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sig1",
          0
        ],
        "latent_image": [
          "cat1",
          0
        ]
      }
    },
    "sep1": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "s1",
          0
        ]
      }
    },
    "ups": {
      "class_type": "LTXVLatentUpsampler",
      "inputs": {
        "samples": [
          "sep1",
          0
        ],
        "upscale_model": [
          "up_model",
          0
        ],
        "vae": [
          "vae",
          0
        ]
      }
    },
    "i2v2": {
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": [
          "vae",
          0
        ],
        "image": [
          "prep",
          0
        ],
        "latent": [
          "ups",
          0
        ],
        "strength": 1.0,
        "bypass": false
      }
    },
    "cat2": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "i2v2",
          0
        ],
        "audio_latent": [
          "frozen",
          0
        ]
      }
    },
    "guider2": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "unet",
          0
        ],
        "positive": [
          "cond",
          0
        ],
        "negative": [
          "cond",
          1
        ],
        "cfg": 1.0
      }
    },
    "noise2": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 42
      }
    },
    "sig2": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "0.909375, 0.725, 0.421875, 0.0"
      }
    },
    "s2": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise2",
          0
        ],
        "guider": [
          "guider2",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sig2",
          0
        ],
        "latent_image": [
          "cat2",
          0
        ]
      }
    },
    "sep2": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "s2",
          0
        ]
      }
    },
    "dec": {
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "samples": [
          "sep2",
          0
        ],
        "vae": [
          "vae",
          0
        ],
        "tile_size": 512,
        "overlap": 64,
        "temporal_size": 64,
        "temporal_overlap": 16
      }
    },
    "video": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "dec",
          0
        ],
        "fps": "{{fps}}",
        "audio": [
          "trim",
          0
        ]
      }
    },
    "save": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "video",
          0
        ],
        "filename_prefix": "showrunner/{{name}}",
        "format": "mp4",
        "format.codec": "h264"
      }
    },
    "last": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "dec",
          0
        ],
        "batch_index": "{{last_index}}",
        "length": 1
      }
    },
    "save_last": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "last",
          0
        ],
        "filename_prefix": "showrunner/{{name}}_last"
      }
    }
  }
}
