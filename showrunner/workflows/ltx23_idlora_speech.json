{
  "$schema": "comfy_workflow_v1",
  "name": "ltx23_idlora_speech",
  "task": "idlora_speech",
  "core_nodes_only": true,
  "verified_live": false,
  "description": "LTX-2.3 22B dev fp8 + distilled LoRA 0.5 + ID-LoRA (TalkVid) 1.0, two-stage, 24 fps. The reference voice (~5 s wav) conditions the model through the native LTXVReferenceAudio node; the prompt uses the [VISUAL]/[SPEECH]/[SOUNDS] sections. Authored from ComfyUI's video_ltx2_3_id_lora.json (2026-10-08), subgraph flattened. Only core nodes of ComfyUI 0.34.0.",
  "placeholders": [
    "image",
    "voice_ref",
    "prompt",
    "negative",
    "seed",
    "width",
    "height",
    "seconds",
    "fps",
    "identity_guidance",
    "name"
  ],
  "files": {
    "image": "the keyframe (png)",
    "voice_ref": "the character's locked voice reference (wav, 5-10 s)"
  },
  "derived": {
    "frames": "1 + floor(fps * seconds / 8) * 8",
    "half_width": "width / 2",
    "half_height": "height / 2",
    "last_index": "frames - 1"
  },
  "defaults": {
    "width": 704,
    "height": 1280,
    "fps": 24,
    "seconds": 5,
    "negative": "live action, real people, photograph, human skin, mask, costume, blurry, deformed mouth, extra limbs, text, subtitles, watermark, pc game, console game, video game, childish, ugly",
    "identity_guidance": 3.0
  },
  "frame_rule": {
    "fps": 24,
    "frame_step": 8,
    "max_frames": 241,
    "lengths": [
      5,
      6,
      8,
      10
    ]
  },
  "requires": [
    {
      "node": "ckpt",
      "field": "ckpt_name",
      "file": "ltx-2.3-22b-dev-fp8.safetensors",
      "dir": "models/checkpoints"
    },
    {
      "node": "te",
      "field": "text_encoder",
      "file": "gemma_3_12B_it_fp4_mixed.safetensors",
      "dir": "models/text_encoders"
    },
    {
      "node": "lora_d",
      "field": "lora_name",
      "file": "ltx_2.3_22b_distilled_1.1_lora_dynamic_fro09_avg_rank_111_bf16.safetensors",
      "dir": "models/loras"
    },
    {
      "node": "lora_id",
      "field": "lora_name",
      "file": "ltx-2.3-id-lora-talkvid-3k.safetensors",
      "dir": "models/loras"
    },
    {
      "node": "up_model",
      "field": "model_name",
      "file": "ltx-2.3-spatial-upscaler-x2-1.1.safetensors",
      "dir": "models/latent_upscale_models"
    }
  ],
  "output_node": "save",
  "last_frame_node": "save_last",
  "graph": {
    "image": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image}}"
      }
    },
    "scale": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "image",
          0
        ],
        "upscale_method": "lanczos",
        "width": "{{width}}",
        "height": "{{height}}",
        "crop": "center"
      }
    },
    "prep": {
      "class_type": "LTXVPreprocess",
      "inputs": {
        "image": [
          "scale",
          0
        ],
        "img_compression": 18
      }
    },
    "ckpt": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev-fp8.safetensors"
      }
    },
    "te": {
      "class_type": "LTXAVTextEncoderLoader",
      "inputs": {
        "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
        "ckpt_name": "ltx-2.3-22b-dev-fp8.safetensors",
        "device": "default"
      }
    },
    "avae": {
      "class_type": "LTXVAudioVAELoader",
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev-fp8.safetensors"
      }
    },
    "lora_d": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "ckpt",
          0
        ],
        "lora_name": "ltx_2.3_22b_distilled_1.1_lora_dynamic_fro09_avg_rank_111_bf16.safetensors",
        "strength_model": 0.5
      }
    },
    "lora_id": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "lora_d",
          0
        ],
        "lora_name": "ltx-2.3-id-lora-talkvid-3k.safetensors",
        "strength_model": 1.0
      }
    },
    "up_model": {
      "class_type": "LatentUpscaleModelLoader",
      "inputs": {
        "model_name": "ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
      }
    },
    "pos": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "te",
          0
        ]
      }
    },
    "neg": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "te",
          0
        ]
      }
    },
    "refaudio": {
      "class_type": "LoadAudio",
      "inputs": {
        "audio": "{{voice_ref}}"
      }
    },
    "ref": {
      "class_type": "LTXVReferenceAudio",
      "inputs": {
        "model": [
          "lora_id",
          0
        ],
        "positive": [
          "pos",
          0
        ],
        "negative": [
          "neg",
          0
        ],
        "reference_audio": [
          "refaudio",
          0
        ],
        "audio_vae": [
          "avae",
          0
        ],
        "identity_guidance_scale": "{{identity_guidance}}",
        "start_percent": 0.0,
        "end_percent": 1.0
      }
    },
    "cond": {
      "class_type": "LTXVConditioning",
      "inputs": {
        "positive": [
          "ref",
          1
        ],
        "negative": [
          "ref",
          2
        ],
        "frame_rate": "{{fps}}"
      }
    },
    "alat": {
      "class_type": "LTXVEmptyLatentAudio",
      "inputs": {
        "audio_vae": [
          "avae",
          0
        ],
        "frames_number": "{{frames}}",
        "frame_rate": "{{fps}}",
        "batch_size": 1
      }
    },
    "crop": {
      "class_type": "LTXVCropGuides",
      "inputs": {
        "positive": [
          "cond",
          0
        ],
        "negative": [
          "cond",
          1
        ],
        "latent": [
          "sep1",
          0
        ]
      }
    },
    "lat1": {
      "class_type": "EmptyLTXVLatentVideo",
      "inputs": {
        "width": "{{half_width}}",
        "height": "{{half_height}}",
        "length": "{{frames}}",
        "batch_size": 1
      }
    },
    "i2v1": {
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": [
          "ckpt",
          2
        ],
        "image": [
          "prep",
          0
        ],
        "latent": [
          "lat1",
          0
        ],
        "strength": 0.7,
        "bypass": false
      }
    },
    "cat1": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "i2v1",
          0
        ],
        "audio_latent": [
          "alat",
          0
        ]
      }
    },
    "guider1": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "ref",
          0
        ],
        "positive": [
          "cond",
          0
        ],
        "negative": [
          "cond",
          1
        ],
        "cfg": 1.0
      }
    },
    "noise1": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{{seed}}"
      }
    },
    "sampler": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "sig1": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
      }
    },
    "s1": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise1",
          0
        ],
        "guider": [
          "guider1",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sig1",
          0
        ],
        "latent_image": [
          "cat1",
          0
        ]
      }
    },
    "sep1": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "s1",
          0
        ]
      }
    },
    "ups": {
      "class_type": "LTXVLatentUpsampler",
      "inputs": {
        "samples": [
          "sep1",
          0
        ],
        "upscale_model": [
          "up_model",
          0
        ],
        "vae": [
          "ckpt",
          2
        ]
      }
    },
    "i2v2": {
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": [
          "ckpt",
          2
        ],
        "image": [
          "prep",
          0
        ],
        "latent": [
          "ups",
          0
        ],
        "strength": 1.0,
        "bypass": false
      }
    },
    "cat2": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "i2v2",
          0
        ],
        "audio_latent": [
          "sep1",
          1
        ]
      }
    },
    "guider2": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "lora_d",
          0
        ],
        "positive": [
          "crop",
          0
        ],
        "negative": [
          "crop",
          1
        ],
        "cfg": 1.0
      }
    },
    "noise2": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 42
      }
    },
    "sig2": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "0.85, 0.7250, 0.4219, 0.0"
      }
    },
    "s2": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "noise2",
          0
        ],
        "guider": [
          "guider2",
          0
        ],
        "sampler": [
          "sampler",
          0
        ],
        "sigmas": [
          "sig2",
          0
        ],
        "latent_image": [
          "cat2",
          0
        ]
      }
    },
    "sep2": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "s2",
          0
        ]
      }
    },
    "adec": {
      "class_type": "LTXVAudioVAEDecode",
      "inputs": {
        "samples": [
          "sep2",
          1
        ],
        "audio_vae": [
          "avae",
          0
        ]
      }
    },
    "dec": {
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "samples": [
          "sep2",
          0
        ],
        "vae": [
          "ckpt",
          2
        ],
        "tile_size": 768,
        "overlap": 64,
        "temporal_size": 4096,
        "temporal_overlap": 4
      }
    },
    "video": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "dec",
          0
        ],
        "fps": "{{fps}}",
        "audio": [
          "adec",
          0
        ]
      }
    },
    "save": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "video",
          0
        ],
        "filename_prefix": "showrunner/{{name}}",
        "format": "mp4",
        "format.codec": "h264"
      }
    },
    "last": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "dec",
          0
        ],
        "batch_index": "{{last_index}}",
        "length": 1
      }
    },
    "save_last": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "last",
          0
        ],
        "filename_prefix": "showrunner/{{name}}_last"
      }
    }
  }
}
