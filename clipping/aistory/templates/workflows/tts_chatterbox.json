{
  "$schema": "comfy_workflow_v1",
  "name": "tts_chatterbox",
  "task": "tts",
  "kind": "audio",
  "min_profile": "low",
  "verified_live": false,
  "description": "Text to speech in French with Chatterbox Multilingual (ResembleAI, MIT) through the FL_ChatterboxMultilingualTTS node of ComfyUI_Fill-ChatterBox, pinned by docker/worker-comfyui-tts (plan 31). The reference voice (audio_path: a 6-30 s mono WAV, uploaded like a keyframe) is read by core LoadAudio; the line (prompt) ends in core SaveAudio as FLAC. The six weight files are loaded by the node itself from models/chatterbox/chatterbox_multilingual/ (an empty requires.field), on the worker's network volume. Needs the worker image of docker/worker-comfyui-tts: the base image has neither the node nor an audio-aware handler.",
  "source": {
    "urls": [
      "https://github.com/filliptm/ComfyUI_Fill-ChatterBox/blob/f7d7a16187430abcaf91a3039b9c83aa9960816a/chatterbox_node.py",
      "https://huggingface.co/ResembleAI/chatterbox",
      "https://github.com/Comfy-Org/ComfyUI/blob/v0.3.64/comfy_extras/nodes_audio.py"
    ],
    "read_on": "2026-10-06",
    "deviations": [
      "language fixed to French (fr); temperature, repetition_penalty, min_p and top_p at the node's defaults",
      "keep_model_loaded true: the next line on a warm worker skips the 3.2 GB load"
    ]
  },
  "placeholders": [
    "prompt",
    "seed",
    "audio_path",
    "exaggeration",
    "cfg_weight"
  ],
  "requires": [
    {
      "node": "2",
      "field": "",
      "file": "ve.pt",
      "dir": "models/chatterbox/chatterbox_multilingual",
      "size": "5.7 MB"
    },
    {
      "node": "2",
      "field": "",
      "file": "t3_mtl23ls_v2.safetensors",
      "dir": "models/chatterbox/chatterbox_multilingual",
      "size": "2.14 GB"
    },
    {
      "node": "2",
      "field": "",
      "file": "s3gen.pt",
      "dir": "models/chatterbox/chatterbox_multilingual",
      "size": "1.06 GB"
    },
    {
      "node": "2",
      "field": "",
      "file": "grapheme_mtl_merged_expanded_v1.json",
      "dir": "models/chatterbox/chatterbox_multilingual",
      "size": "70 KB"
    },
    {
      "node": "2",
      "field": "",
      "file": "conds.pt",
      "dir": "models/chatterbox/chatterbox_multilingual",
      "size": "107 KB"
    },
    {
      "node": "2",
      "field": "",
      "file": "Cangjie5_TC.json",
      "dir": "models/chatterbox/chatterbox_multilingual",
      "size": "1.9 MB"
    }
  ],
  "audio_node": "1",
  "output_node": "3",
  "graph": {
    "1": {
      "class_type": "LoadAudio",
      "inputs": {
        "audio": "{{audio_path}}"
      }
    },
    "2": {
      "class_type": "FL_ChatterboxMultilingualTTS",
      "inputs": {
        "text": "{{prompt}}",
        "language": "French (fr)",
        "exaggeration": "{{exaggeration}}",
        "cfg_weight": "{{cfg_weight}}",
        "temperature": 0.8,
        "repetition_penalty": 2.0,
        "min_p": 0.05,
        "top_p": 1.0,
        "seed": "{{seed}}",
        "audio_prompt": [
          "1",
          0
        ],
        "use_cpu": false,
        "keep_model_loaded": true
      }
    },
    "3": {
      "class_type": "SaveAudio",
      "inputs": {
        "filename_prefix": "rzdhop_ai/tts",
        "audio": [
          "2",
          0
        ]
      }
    }
  }
}
