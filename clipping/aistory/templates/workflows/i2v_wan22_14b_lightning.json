{
  "$schema": "comfy_workflow_v1",
  "name": "i2v_wan22_14b_lightning",
  "task": "i2v",
  "min_profile": "high",
  "verified_live": false,
  "core_nodes_only": true,
  "description": "Image to video with Wan 2.2 I2V A14B fp8 (Apache-2.0) and the lightx2v 4-step Lightning LoRAs, 16 fps: the high-noise model takes steps 0-2 of 4, the low-noise model steps 2-4, cfg 1. Authored from ComfyUI's own graph https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_wan2_2_14B_i2v.json (read 2026-09-30), its subgraph flattened along the Lightning branch of its switch (LoRA models, 4 steps, cfg 1, split at step 2); frames = 16 x seconds + 1 as its own length expression. Literal inputs replaced by the spec 8.7 placeholders. 480x832 is Wan 2.2 A14B's 480P in 9:16 (the source's square default is 640x640). Only ComfyUI core nodes. Never run on a GPU here (A-035): verified against a fake ComfyUI only.",
  "source": {
    "urls": [
      "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_wan2_2_14B_i2v.json",
      "https://comfyanonymous.github.io/ComfyUI_examples/wan22/"
    ],
    "read_on": "2026-09-30",
    "deviations": [
      "subgraph flattened; its ComfySwitchNode/Primitive nodes resolved to the Lightning branch",
      "480x832 instead of the square 640x640 default",
      "SaveVideo format mp4/h264 instead of auto/auto"
    ]
  },
  "placeholders": [
    "image_path",
    "prompt",
    "negative",
    "seed",
    "width",
    "height",
    "frames",
    "fps"
  ],
  "frame_rule": {
    "fps": 16,
    "frame_step": 4,
    "max_frames": 81,
    "width": 480,
    "height": 832,
    "lengths": [
      2,
      3,
      4,
      5
    ],
    "rule": "frames = fps x seconds rounded up to a multiple of frame_step, plus 1 (Wan: 4n+1)"
  },
  "requires": [
    {
      "node": "95",
      "field": "unet_name",
      "file": "wan2.2_i2v_high_noise_14B_fp8_scaled.safetensors",
      "dir": "models/diffusion_models"
    },
    {
      "node": "96",
      "field": "unet_name",
      "file": "wan2.2_i2v_low_noise_14B_fp8_scaled.safetensors",
      "dir": "models/diffusion_models"
