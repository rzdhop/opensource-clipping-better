{
  "$schema": "comfy_workflow_v1",
  "name": "i2v_ltx2",
  "task": "i2v",
  "min_profile": "pro",
  "verified_live": false,
  "core_nodes_only": true,
  "description": "Image to video with LTX-2 19B dev fp8 (LTX-2 Community License), 25 fps, in two passes: half size with 20 LTXVScheduler steps at cfg 4, then the x2 latent upscaler and 3 steps with the distilled LoRA at cfg 1. Authored from ComfyUI's own graph https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_ltx2_i2v.json (read 2026-09-30; the template docs.comfy.org/tutorials/video/ltx/ltx-2 links), its subgraph flattened. Its notes: width and height divisible by 64, frame count 8n+1 (121 by default), 720p by default: 704x1280 is 720p in 9:16 divisible by 64. LTX-2 makes sound with the picture; the joint audio latent is kept (the model needs it) but not decoded: the clip is saved silent (tier 2 never keeps a model's sound). Only ComfyUI core nodes. Never run on a GPU here (A-035): verified against a fake ComfyUI only.",
  "source": {
    "urls": [
      "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_ltx2_i2v.json",
      "https://docs.comfy.org/tutorials/video/ltx/ltx-2"
    ],
    "read_on": "2026-09-30",
    "deviations": [
      "subgraph flattened; its two bypassed camera LoRA nodes dropped (a bypassed node passes its model on)",
      "ResizeImageMaskNode 'scale dimensions' (1280x720, center) -> ImageScale lanczos {{width}}x{{height}} center",
      "EmptyImage(size of the keyframe) -> ImageScaleBy 0.5 -> GetImageSize -> the keyframe itself scaled by 0.5, same sizes",
      "ResizeImageMaskNode 'scale longer dimension' 1536 area -> ImageScaleToMaxDimension area 1536",
      "LTXVAudioVAEDecode dropped and CreateVideo given no audio: the clip is silent",
      "SaveVideo format mp4/h264 instead of auto/auto/auto"
    ]
  },
  "placeholders": [
    "image_path",
    "prompt",
    "negative",
    "seed",
    "width",
    "height",
    "frames",
    "fps"
  ],
  "frame_rule": {
    "fps": 25,
    "frame_step": 8,
    "max_frames": 121,
    "width": 704,
    "height": 1280,
    "lengths": [
      2,
      3,
      4
    ],
    "rule": "frames = fps x seconds rounded up to a multiple of frame_step, plus 1 (LTX: 8n+1); 5 s would need 129 frames, above the source's 121, so it is not offered"
  },
  "requires": [
    {
      "node": "1",
      "field": "ckpt_name",
      "file": "ltx-2-19b-dev-fp8.safetensors",
      "dir": "models/checkpoints"
    },
    {
      "node": "48",
      "field": "ckpt_name",
      "file": "ltx-2-19b-dev-fp8.safetensors",
      "dir": "models/checkpoints"
    },
    {
      "node": "60",
      "field": "text_encoder",
      "file": "gemma_3_12B_it_fp4_mixed.safetensors",
      "dir": "models/text_encoders"
    },
    {
      "node": "60",
      "field": "ckpt_name",
      "file": "ltx-2-19b-dev-fp8.safetensors",
      "dir": "models/checkpoints"
    },
    {
      "node": "68",
      "field": "lora_name",
      "file": "ltx-2-19b-distilled-lora-384.safetensors",
      "dir": "models/loras"
    },
    {
      "node": "76",
      "field": "model_name",
      "file": "ltx-2-spatial-upscaler-x2-1.0.safetensors",
      "dir": "models/latent_upscale_models"
    }
  ],
  "image_node": "98",
  "output_node": "75",
  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "ltx-2-19b-dev-fp8.safetensors"
      }
    },
    "60": {
      "class_type": "LTXAVTextEncoderLoader",
      "inputs": {
        "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
        "ckpt_name": "ltx-2-19b-dev-fp8.safetensors",
        "device": "default"
      }
    },
    "48": {
      "class_type": "LTXVAudioVAELoader",
      "inputs": {
        "ckpt_name": "ltx-2-19b-dev-fp8.safetensors"
      }
    },
    "76": {
      "class_type": "LatentUpscaleModelLoader",
      "inputs": {
        "model_name": "ltx-2-spatial-upscaler-x2-1.0.safetensors"
      }
    },
    "68": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "ltx-2-19b-distilled-lora-384.safetensors",
        "strength_model": 1.0
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "60",
          0
        ]
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "60",
          0
        ]
      }
    },
    "22": {
      "class_type": "LTXVConditioning",
      "inputs": {
        "positive": [
          "3",
          0
        ],
        "negative": [
          "4",
          0
        ],
        "frame_rate": "{{fps}}"
      }
    },
    "98": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image_path}}"
      }
    },
    "102": {
      "class_type": "ImageScale",
      "inputs": {
        "image": [
          "98",
          0
        ],
        "upscale_method": "lanczos",
        "width": "{{width}}",
        "height": "{{height}}",
        "crop": "center"
      }
    },
    "90": {
      "class_type": "ImageScaleBy",
      "inputs": {
        "image": [
          "102",
          0
        ],
        "upscale_method": "lanczos",
        "scale_by": 0.5
      }
    },
    "91": {
      "class_type": "GetImageSize",
      "inputs": {
        "image": [
          "90",
          0
        ]
      }
    },
    "43": {
      "class_type": "EmptyLTXVLatentVideo",
      "inputs": {
        "width": [
          "91",
          0
        ],
        "height": [
          "91",
          1
        ],
        "length": "{{frames}}",
        "batch_size": 1
      }
    },
    "113": {
      "class_type": "ImageScaleToMaxDimension",
      "inputs": {
        "image": [
          "102",
          0
        ],
        "upscale_method": "area",
        "largest_size": 1536
      }
    },
    "99": {
      "class_type": "LTXVPreprocess",
      "inputs": {
        "image": [
          "113",
          0
        ],
        "img_compression": 33
      }
    },
    "107": {
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": [
          "1",
          2
        ],
        "image": [
          "99",
          0
        ],
        "latent": [
          "43",
          0
        ],
        "strength": 1.0,
        "bypass": false
      }
    },
    "51": {
      "class_type": "LTXVEmptyLatentAudio",
      "inputs": {
        "audio_vae": [
          "48",
          0
        ],
        "frames_number": "{{frames}}",
        "frame_rate": "{{fps}}",
        "batch_size": 1
      }
    },
    "56": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "107",
          0
        ],
        "audio_latent": [
          "51",
          0
        ]
      }
    },
    "9": {
      "class_type": "LTXVScheduler",
      "inputs": {
        "steps": 20,
        "max_shift": 2.05,
        "base_shift": 0.95,
        "stretch": true,
        "terminal": 0.1,
        "latent": [
          "56",
          0
        ]
      }
    },
    "8": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "11": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{{seed}}"
      }
    },
    "47": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "positive": [
          "22",
          0
        ],
        "negative": [
          "22",
          1
        ],
        "cfg": 4.0
      }
    },
    "41": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "11",
          0
        ],
        "guider": [
          "47",
          0
        ],
        "sampler": [
          "8",
          0
        ],
        "sigmas": [
          "9",
          0
        ],
        "latent_image": [
          "56",
          0
        ]
      }
    },
    "80": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "41",
          0
        ]
      }
    },
    "81": {
      "class_type": "LTXVCropGuides",
      "inputs": {
        "positive": [
          "22",
          0
        ],
        "negative": [
          "22",
          1
        ],
        "latent": [
          "80",
          0
        ]
      }
    },
    "84": {
      "class_type": "LTXVLatentUpsampler",
      "inputs": {
        "samples": [
          "81",
          2
        ],
        "upscale_model": [
          "76",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "108": {
      "class_type": "LTXVImgToVideoInplace",
      "inputs": {
        "vae": [
          "1",
          2
        ],
        "image": [
          "99",
          0
        ],
        "latent": [
          "84",
          0
        ],
        "strength": 1.0,
        "bypass": false
      }
    },
    "83": {
      "class_type": "LTXVConcatAVLatent",
      "inputs": {
        "video_latent": [
          "108",
          0
        ],
        "audio_latent": [
          "80",
          1
        ]
      }
    },
    "67": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": 0
      }
    },
    "82": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": [
          "68",
          0
        ],
        "positive": [
          "81",
          0
        ],
        "negative": [
          "81",
          1
        ],
        "cfg": 1.0
      }
    },
    "66": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "gradient_estimation"
      }
    },
    "73": {
      "class_type": "ManualSigmas",
      "inputs": {
        "sigmas": "0.909375, 0.725, 0.421875, 0.0"
      }
    },
    "70": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": [
          "67",
          0
        ],
        "guider": [
          "82",
          0
        ],
        "sampler": [
          "66",
          0
        ],
        "sigmas": [
          "73",
          0
        ],
        "latent_image": [
          "83",
          0
        ]
      }
    },
    "105": {
      "class_type": "LTXVSeparateAVLatent",
      "inputs": {
        "av_latent": [
          "70",
          1
        ]
      }
    },
    "95": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "105",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "97": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "95",
          0
        ],
        "fps": "{{fps}}"
      }
    },
    "75": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "97",
          0
        ],
        "filename_prefix": "rzdhop_ai/i2v_ltx2",
        "format": "mp4",
        "format.codec": "h264",
        "codec": "h264"
      }
    }
  }
}
