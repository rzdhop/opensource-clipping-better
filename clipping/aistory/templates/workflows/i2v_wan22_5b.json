{
  "$schema": "comfy_workflow_v1",
  "name": "i2v_wan22_5b",
  "task": "i2v",
  "min_profile": "mid",
  "verified_live": false,
  "core_nodes_only": true,
  "description": "Image to video with Wan 2.2 TI2V 5B (Apache-2.0), 24 fps. Authored from ComfyUI's own graph https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_wan2_2_5B_ti2v.json (read 2026-09-30; the template docs.comfy.org/tutorials/video/wan/wan2_2 links, the same nodes as comfyanonymous.github.io/ComfyUI_examples/wan22/ image_to_video_wan22_5B.json, whose note gives 1280x704 and length 121 as optimal). Literal inputs replaced by the spec 8.7 placeholders; the start image is the uploaded keyframe; the size is the source's 1280x704 turned to 9:16. Only ComfyUI core nodes. Never run on a GPU here (A-035): verified against a fake ComfyUI only.",
  "source": {
    "urls": [
      "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_wan2_2_5B_ti2v.json",
      "https://comfyanonymous.github.io/ComfyUI_examples/wan22/"
    ],
    "read_on": "2026-09-30",
    "deviations": [
      "SaveVideo format mp4/h264 instead of auto/auto (auto resolves to mp4/h264 anyway)",
      "the source's disabled LoadImage is enabled as the keyframe"
    ]
  },
  "placeholders": [
    "image_path",
    "prompt",
    "negative",
    "seed",
    "width",
    "height",
    "frames",
    "fps"
  ],
  "frame_rule": {
    "fps": 24,
    "frame_step": 4,
    "max_frames": 121,
    "width": 704,
    "height": 1280,
    "lengths": [
      2,
      3,
      4,
      5
    ],
    "rule": "frames = fps x seconds rounded up to a multiple of frame_step, plus 1 (Wan: 4n+1)"
  },
  "requires": [
    {
      "node": "37",
      "field": "unet_name",
      "file": "wan2.2_ti2v_5B_fp16.safetensors",
      "dir": "models/diffusion_models"
    },
    {
      "node": "38",
      "field": "clip_name",
      "file": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "dir": "models/text_encoders"
    },
    {
      "node": "39",
      "field": "vae_name",
      "file": "wan2.2_vae.safetensors",
      "dir": "models/vae"
    }
  ],
  "image_node": "56",
  "output_node": "58",
  "graph": {
    "37": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
        "weight_dtype": "default"
      }
    },
    "38": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      }
    },
    "39": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan2.2_vae.safetensors"
      }
    },
    "48": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": [
          "37",
          0
        ],
        "shift": 8.0
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "38",
          0
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "38",
          0
        ]
      }
    },
    "56": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image_path}}"
      }
    },
    "55": {
      "class_type": "Wan22ImageToVideoLatent",
      "inputs": {
        "vae": [
          "39",
          0
        ],
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{frames}}",
        "batch_size": 1,
        "start_image": [
          "56",
          0
        ]
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "48",
          0
        ],
        "seed": "{{seed}}",
        "steps": 20,
        "cfg": 5.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "55",
          0
        ],
        "denoise": 1.0
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "39",
          0
        ]
      }
    },
    "57": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "fps": "{{fps}}"
      }
    },
    "58": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "57",
          0
        ],
        "filename_prefix": "rzdhop_ai/i2v_wan22_5b",
        "format": "mp4",
        "format.codec": "h264",
        "codec": "h264"
      }
    }
  }
}
