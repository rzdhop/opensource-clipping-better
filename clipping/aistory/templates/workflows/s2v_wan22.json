{
  "$schema": "comfy_workflow_v1",
  "name": "s2v_wan22",
  "task": "s2v",
  "kind": "video",
  "min_profile": "high",
  "verified_live": false,
  "served_by": "audio",
  "core_nodes_only": true,
  "description": "Sound to video with Wan 2.2 S2V 14B fp8 (Apache-2.0): a keyframe (image_path) and a spoken line (audio_path, a WAV) make a talking clip of up to 5 s at 16 fps, the mouth following the voice. Authored from ComfyUI's own graph https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_wan2_2_14B_s2v.json (read 2026-10-06), its 4-step lightx2v LoRA branch (T2V v1.1 high-noise LoRA, 4 steps, cfg 1, uni_pc/simple, shift 8) with one 77-frame chunk and without its Video S2V Extend subgraphs. The first latent frame is doubled before decoding and the first 3 decoded frames dropped (ComfyUI's own 'first frame overbaked by the VAE' hack): one chunk decodes to 81 frames, 78 remain, so a 5 s request is 78 frames (4.9 s) and shorter audio idles the mouth. The sampler length stays 77 (the model needs at least 73); the frames placeholder only trims the decoded batch (ImageFromBatch clamps). The ref image is center-cropped to width x height. Only ComfyUI core nodes (WanSoundImageToVideo, AudioEncoderLoader and AudioEncoderEncode need ComfyUI 0.3.53 or later). Not run live: unverified on cartoon faces and on French; the models need the audio_encoders folder of the worker image (docker/worker-comfyui-tts links it to the network volume).",
  "source": {
    "urls": [
      "https://raw.githubusercontent.com/Comfy-Org/workflow_templates/main/templates/video_wan2_2_14B_s2v.json",
      "https://raw.githubusercontent.com/Comfy-Org/ComfyUI/v0.34.0/comfy_extras/nodes_wan.py",
      "https://raw.githubusercontent.com/Comfy-Org/ComfyUI/v0.34.0/comfy_extras/nodes_latent.py",
      "https://raw.githubusercontent.com/Comfy-Org/ComfyUI/v0.34.0/comfy_extras/nodes_audio_encoder.py",
      "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/tree/main/split_files"
    ],
    "read_on": "2026-10-06",
    "deviations": [
      "one 77-frame chunk: the Video S2V Extend subgraphs of the source are dropped",
      "only the 4-step Lightning branch (the source's 20-step branch is bypassed there)",
      "480x832 (9:16) instead of the square 640x640 default; sizes are a multiple of 16",
      "seed, prompt, negative, size and frame count are placeholders; the source's fixed values are the literals",
      "SaveVideo format mp4/h264 instead of auto/auto, as the other video templates"
    ]
  },
  "placeholders": [
    "image_path",
    "audio_path",
    "prompt",
    "negative",
    "seed",
    "width",
    "height",
    "frames",
    "fps"
  ],
  "frame_rule": {
    "fps": 16,
    "frame_step": 4,
    "max_frames": 81,
    "width": 480,
    "height": 832,
    "lengths": [
      2,
      3,
      4,
      5
    ],
    "rule": "frames = fps x seconds rounded up to a multiple of frame_step, plus 1 (Wan: 4n+1); the sampler chunk stays 77 and ImageFromBatch trims the decoded batch (78 frames at most)"
  },
  "requires": [
    {
      "node": "1",
      "field": "unet_name",
      "file": "wan2.2_s2v_14B_fp8_scaled.safetensors",
      "dir": "models/diffusion_models",
      "size": "16.4 GB"
    },
    {
      "node": "2",
      "field": "lora_name",
      "file": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise.safetensors",
      "dir": "models/loras",
      "size": "1.2 GB"
    },
    {
      "node": "4",
      "field": "clip_name",
      "file": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "dir": "models/text_encoders"
    },
    {
      "node": "5",
      "field": "vae_name",
      "file": "wan_2.1_vae.safetensors",
      "dir": "models/vae"
    },
    {
      "node": "6",
      "field": "audio_encoder_name",
      "file": "wav2vec2_large_english_fp16.safetensors",
      "dir": "models/audio_encoders",
      "size": "0.63 GB"
    }
  ],
  "image_node": "9",
  "audio_node": "7",
  "output_node": "25",
  "graph": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "wan2.2_s2v_14B_fp8_scaled.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "LoraLoaderModelOnly",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "lora_name": "wan2.2_t2v_lightx2v_4steps_lora_v1.1_high_noise.safetensors",
        "strength_model": 1.0
      }
    },
    "3": {
      "class_type": "ModelSamplingSD3",
      "inputs": {
        "model": [
          "2",
          0
        ],
        "shift": 8.0
      }
    },
    "4": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
        "type": "wan",
        "device": "default"
      }
    },
    "5": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan_2.1_vae.safetensors"
      }
    },
    "6": {
      "class_type": "AudioEncoderLoader",
      "inputs": {
        "audio_encoder_name": "wav2vec2_large_english_fp16.safetensors"
      }
    },
    "7": {
      "class_type": "LoadAudio",
      "inputs": {
        "audio": "{{audio_path}}"
      }
    },
    "8": {
      "class_type": "AudioEncoderEncode",
      "inputs": {
        "audio_encoder": [
          "6",
          0
        ],
        "audio": [
          "7",
          0
        ]
      }
    },
    "9": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{image_path}}"
      }
    },
    "10": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{prompt}}",
        "clip": [
          "4",
          0
        ]
      }
    },
    "11": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "{{negative}}",
        "clip": [
          "4",
          0
        ]
      }
    },
    "12": {
      "class_type": "WanSoundImageToVideo",
      "inputs": {
        "positive": [
          "10",
          0
        ],
        "negative": [
          "11",
          0
        ],
        "vae": [
          "5",
          0
        ],
        "width": "{{width}}",
        "height": "{{height}}",
        "length": 77,
        "batch_size": 1,
        "audio_encoder_output": [
          "8",
          0
        ],
        "ref_image": [
          "9",
          0
        ]
      }
    },
    "13": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "3",
          0
        ],
        "seed": "{{seed}}",
        "steps": 4,
        "cfg": 1.0,
        "sampler_name": "uni_pc",
        "scheduler": "simple",
        "positive": [
          "12",
          0
        ],
        "negative": [
          "12",
          1
        ],
        "latent_image": [
          "12",
          2
        ],
        "denoise": 1.0
      }
    },
    "20": {
      "class_type": "LatentCut",
      "inputs": {
        "samples": [
          "13",
          0
        ],
        "dim": "t",
        "index": 0,
        "amount": 1
      }
    },
    "21": {
      "class_type": "LatentConcat",
      "inputs": {
        "samples1": [
          "20",
          0
        ],
        "samples2": [
          "13",
          0
        ],
        "dim": "t"
      }
    },
    "22": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "21",
          0
        ],
        "vae": [
          "5",
          0
        ]
      }
    },
    "23": {
      "class_type": "ImageFromBatch",
      "inputs": {
        "image": [
          "22",
          0
        ],
        "batch_index": 3,
        "length": "{{frames}}"
      }
    },
    "24": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": [
          "23",
          0
        ],
        "fps": "{{fps}}",
        "audio": [
          "7",
          0
        ]
      }
    },
    "25": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": [
          "24",
          0
        ],
        "filename_prefix": "rzdhop_ai/s2v_wan22",
        "format": "mp4",
        "format.codec": "h264",
        "codec": "h264"
      }
    }
  }
}
