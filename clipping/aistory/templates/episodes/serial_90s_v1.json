{
  "$schema": "episode_template_v1",
  "template_id": "serial_90s_v1",
  "version": 1,
  "label": {"fr": "Épisode de 90 secondes", "en": "90-second episode"},
  "window_s": [75, 100],
  "target_s": 85,
  "tighten_above_s": 95,
  "scenes": [8, 12],
  "shots": [20, 40],
  "min_shot_s": 0.8,
  "recap_from_episode": 2,
  "default_body_count": 10,
  "slots": {
    "recap":       {"functions": ["recap"], "count": [1, 1], "duration_s": [2.0, 3.0]},
    "hook":        {"functions": ["hook"], "count": [1, 1], "duration_s": [1.5, 3.5]},
    "body":        {"functions": ["setup", "rising", "peak", "turn"], "count": [6, 10], "duration_s": [5.0, 10.0]},
    "cliffhanger": {"functions": ["cliffhanger"], "count": [1, 1], "duration_s": [2.0, 5.0]}
  },
  "pauses_s": {"before_first_line": 0.35, "between_lines": 0.25, "tail": 0.6, "tail_peak": 1.2, "tail_floor": 0.3},
  "tail_peak_functions": ["peak", "cliffhanger"],
  "hold_extension_max_s": 1.0,
  "end_card_s": 1.0,
  "transitions_s": {"cut": 0.0, "dissolve": 0.4, "fadeblack": 0.4, "fadewhite": 0.3, "wipeleft": 0.3, "wiperight": 0.3, "slideup": 0.3},
  "notes": "Authored, not measured: spec 00-MASTER-SPEC.md section 6.2 gives only the 75-100 s window for this template (the other reference episode ran 99 s). The body, shot and duration ranges scale the serial_60s_v1 numbers to the longer runtime; the pause, tail and transition timings are kept identical since nothing in the reference analysis suggests they should change with length."
}
