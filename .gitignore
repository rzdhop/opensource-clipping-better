# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Output artifacts (generated by clipping pipeline)
outputs/
*.mp4
*.ts
*.ass
*.jpg
*.tflite
# Models and fonts are downloaded into the working directory at run time
# (cfg.base_dir is os.getcwd()), so they land in the repo root.
*.ttf
face_yolov*.pt
# *.mp3
custom_fonts/
render_manifest*.json
metadata_preview.json

# Secrets
.env
# Written by web/api/settings_store.py: the API keys entered on the
# dashboard Settings page. .local/ is listed again below as a cache dir --
# it is repeated here because THIS is the reason it must never be committed.
.local/settings.json
credentials.json
youtube_token.json
.credentials/

# User Local Caches & Workspaces
.cache/
.local/
.pytest_cache/
.ruff_cache/
uploads/

# YouTube Tracker local database
youtube_tracker/*.sqlite3

# Frontend dependencies. Never commit these: `npm install` in
# web/dashboard/ produces ~480MB that the Docker build recreates anyway.
node_modules/
web/dashboard/node_modules/
data/

# The dashboard is built into the image, not committed.
web/dashboard/dist/
