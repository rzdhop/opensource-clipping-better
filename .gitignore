# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Output artifacts (generated by clipping pipeline)
outputs/
*.mp4
*.ts
*.ass
*.jpg
*.tflite
# Models and fonts are downloaded into the working directory at run time
# (cfg.base_dir is os.getcwd()), so they land in the repo root.
*.ttf
face_yolov*.pt
# *.mp3
custom_fonts/
render_manifest*.json
metadata_preview.json

# Secrets
.env
# Written by web/api/settings_store.py: the API keys entered on the
# dashboard Settings page. .local/ is listed again below as a cache dir --
# it is repeated here because THIS is the reason it must never be committed.
.local/settings.json
credentials.json
youtube_token.json
.credentials/

# User Local Caches & Workspaces
.cache/
.local/
.pytest_cache/
.ruff_cache/
uploads/

# YouTube Tracker local database
youtube_tracker/*.sqlite3

# Frontend dependencies. Never commit these: `npm install` in
# web/dashboard/ produces ~480MB that the Docker build recreates anyway.
node_modules/
web/dashboard/node_modules/

# Runtime secrets: the API token and the saved Settings values. Ignored, but the
# DIRECTORY is tracked (via data/.gitkeep) on purpose. docker-compose bind-mounts
# ./data, and Docker creates a missing bind-mount source as ROOT -- after which
# the container, running as the host user, cannot write it. The symptom is not an
# error page: the backend prints "Could not save the API token", the token then
# CHANGES ON EVERY RESTART, and PUT /api/settings answers 200 while the write
# silently fails. Keeping the directory in the repo means a fresh clone already
# owns it and Docker never creates it.
data/*
!data/.gitkeep

# The dashboard is built into the image, not committed.
web/dashboard/dist/

# Backups of the local .env, made before rewriting it. Secrets: never commit.
.env.backup-*

# One machine's own compose settings, e.g. DISABLE_AUTH (DEC-092). Never shared.
docker-compose.override.yml
