# Copy to .env and fill in what you need:  cp .env.example .env

# --- Container user -------------------------------------------------------
# docker-compose bind-mounts ./uploads and ./outputs into the backend. A bind
# mount keeps the HOST's ownership, so the container must run as the user that
# owns those directories or every upload fails with
#   PermissionError: [Errno 13] Permission denied: '/app/uploads/<file>'
# Defaults to 1000:1000, which is correct for the first user on most Linux
# distributions. Check yours with `id -u` and `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000

# --- AI providers ---------------------------------------------------------
# The analysis talks to free, OpenAI-compatible endpoints through an ordered
# CHAIN. Each link is "<provider>/<model>", tried in order; every hop is
# printed, a link whose key is missing is skipped with a line saying so, and a
# provider that is not named here is never contacted.
#
# Leave LLM_CHAIN empty to use the shipped default:
#   groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite,openrouter/mistralai/mistral-small-3.2-24b-instruct,mistral/mistral-small-latest,nvidia/nvidia/nemotron-3.5-lightning-30b-a3b
# Groq first because it is by far the fastest free tier, Gemini second because
# its daily request budget is the largest, OpenRouter third because it is paid
# (so it is only spent when both free tiers failed), Mistral fourth, NVIDIA
# last because it has no published daily cap. A link with no key is skipped.
#
# Measure before you choose: python tools/bench_llm.py
LLM_CHAIN=

# Provider keys. The default chain uses Groq, Gemini, OpenRouter, Mistral,
# then NVIDIA.
#
# SET AT LEAST ONE OF GROQ, GEMINI, OPENROUTER OR MISTRAL. They are the chain's
# primary links; all but OpenRouter are free. NVIDIA is its floor: ~12
# tokens/s behind a queue that can hold a request for a minute, so a job whose
# only key is NVIDIA's is refused before it starts (see ALLOW_SLOW_CHAIN below).
#
# https://console.groq.com/keys   — also powers hosted transcription.
GROQ_API_KEY=

# https://aistudio.google.com/apikey — also needed for --voiceover.
GOOGLE_API_KEY=

# https://build.nvidia.com/ — NVIDIA NIM. A backup, not a primary.
NVIDIA_API_KEY=

# Run a job anyway when NVIDIA is the only keyed link. Same as
# --allow-slow-chain, or the "Run on the slow chain anyway" toggle in Settings.
# Expect the analysis to take tens of minutes and to skip windows when the time
# budget runs out. 1 to enable; leave empty otherwise.
ALLOW_SLOW_CHAIN=

# https://openrouter.ai/keys — PAID: the default model is
# mistralai/mistral-small-3.2-24b-instruct, a few tenths of a cent per job.
# Its ":free" models were measured unable to do the analysis (2026-09-24).
OPENROUTER_API_KEY=

# https://console.mistral.ai/ — free "Experiment" tier; also Voxtral transcription.
MISTRAL_API_KEY=

# Any other OpenAI-compatible endpoint, including a local one. Reachable in the
# chain as "custom/<model>".
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=

# [OPTIONAL] Any other OpenAI-compatible endpoint, used with
# `--ai-provider openai_compat`. Only worth setting if you already have a key
# somewhere else -- Groq and Gemini above are free.
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   xAI         https://api.x.ai/v1
#   Ollama      http://localhost:11434/v1   (key ignored, but must be non-empty)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional: B-roll footage for Clips mode. Sources are tried in BROLL_SOURCES
# order (default local,pexels,pixabay); one with no key or folder is skipped, so
# a Pexels key alone behaves as it always did. Clips that use stock footage carry
# its credit in render_manifest.json (`broll_credits`).
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ — free key, 100 requests per minute.
PIXABAY_API_KEY=
# Your own clips (mp4/mov/webm): the folder must be ./broll (/app/broll in the
# container). Leave both empty to keep the defaults.
#   BROLL_SOURCES=local,pexels,pixabay
#   BROLL_LOCAL_DIR=/app/broll

# Optional: required only for diarization (split-screen / camera-switch).
# Also needs the pyannote model licence accepted on HuggingFace.
HF_TOKEN=

# --- Generation providers (AI Story, spec 8.1) ---

# Five more chains with LLM_CHAIN's grammar: ordered "<provider>/<model>" links,
# a link without its key is skipped with a line saying so, a provider not named
# is never contacted, and a PAID link runs only when ALLOW_PAID=1 and the caps
# allow it. Leave empty for the shipped defaults:
#   IMAGE_CHAIN       cloudflare/flux-1-schnell,pollinations/flux,local/comfyui,fal/flux-schnell,openai/gpt-image-2-low
#   IMAGE_EDIT_CHAIN  local/comfyui,gemini/nano-banana-2-lite,fal/seedream-4-edit,fal/flux-kontext-pro,gemini/nano-banana-2
#   VIDEO_CHAIN       local/comfyui,fal/seedance-1-pro-fast,fal/ltx-2.3-fast,fal/kling-2.5-turbo-std,gemini/veo-3.1-lite,fal/ltx-2.5-fast
#   TTS_CHAIN         gemini/flash-lite-tts,local/piper,local/kokoro,local/chatterbox,elevenlabs/flash
#   VISION_CHAIN      gemini/flash-lite,openrouter/qwen/qwen3.8-27b:free,local/ollama-vision,gemini/flash
# fal/ltx-2.5-fast ends VIDEO_CHAIN so it never changes an automatic pick; an episode reaches it through its
# video-link switch (FAL_KEY; clips of 6 to 20 s, with sound when asked).
# Local TTS (local/piper, local/kokoro, local/chatterbox -- chatterbox clones a
# character's own voice recording, uploaded in the cast step) is not in the
# default image. To add it, set this in .env for `docker compose build` (compose reads
# it from there); torch and the engines add about 2 GB to the image, and on
# a 4-core ARM host without a GPU synthesis is slower than real time:
# INSTALL_LOCAL_TTS=1
IMAGE_CHAIN=
IMAGE_EDIT_CHAIN=
VIDEO_CHAIN=
TTS_CHAIN=
VISION_CHAIN=

# Keys. Gemini reuses GOOGLE_API_KEY (its image models are billed, its text,
# vision and TTS are free), OpenRouter reuses OPENROUTER_API_KEY.
# https://fal.ai/dashboard/keys — PAID per image / per second of video.
FAL_KEY=
# https://platform.openai.com/api-keys — PAID (gpt-image-2). A real OpenAI
# account; not the OPENAI_COMPAT_* endpoint above.
OPENAI_API_KEY=
# https://dash.cloudflare.com/profile/api-tokens — Workers AI, free allowance
# of about 170 flux-1-schnell images a day. Needs the account id too.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# https://auth.pollinations.ai/ — optional: keyless works at the legacy rate.
POLLINATIONS_API_KEY=
# https://aistudio.google.com/apikey — PAID, Veo (gemini/veo-3.1-lite) and the
# "gemini-paid" LLM provider (AI Story's premium writing chain, below) only: a
# key from a SEPARATE Google project with billing enabled, so a clip or a
# premium LLM call is never billed to GOOGLE_API_KEY's project. No other
# gemini link reads it.
GEMINI_PAID_API_KEY=
# https://platform.claude.com/settings/keys — PAID per request: Claude on the
# Anthropic API, for anthropic/ links of the premium writing chain below
# (anthropic/claude-sonnet-5-5, or anthropic/claude-opus-5-5; an effort may
# follow as @low|@medium|@high|@xhigh). Spent only with allow_paid on, every
# request booked; the Settings check is free (a model lookup, never a request).
ANTHROPIC_API_KEY=
# https://elevenlabs.io/app/settings/api-keys — PAID per character: ElevenLabs
# voices (elevenlabs/flash, elevenlabs/multilingual-v2), the last link of
# TTS_CHAIN, with word timestamps. Spent only with allow_paid on, every line
# booked; a story never picks one of its voices by itself.
ELEVENLABS_API_KEY=

# AI Story's premium writing chain (DEC-273): concepts, the bible, the
# episode script and the first-watch judge -- STORY_LLM_CHAIN (Settings, or
# this file) writes everything else. Same grammar as LLM_CHAIN; empty falls
# through to STORY_LLM_CHAIN, then LLM_CHAIN, then the shipped default (the
# paid Gemini project first, GEMINI_PAID_API_KEY above, then today's free
# chain).
STORY_LLM_PREMIUM_CHAIN=

# Local generation servers. Empty = http://127.0.0.1:8188 / :11434 on a host,
# http://host.docker.internal:8188 / :11434 inside the container.
LOCAL_COMFYUI_URL=
LOCAL_OLLAMA_URL=

# RunPod Serverless ComfyUI (DEC-310; runbook 11-INFRA): the same workflow
# templates local/comfyui runs (templates/workflows/), on a rented GPU billed
# per second while a clip renders; idle costs nothing. PAID: every clip is
# booked, allow_paid must be on. The link names the template, e.g.
#   VIDEO_CHAIN=local/comfyui,runpod/i2v_wan22_14b_lightning,fal/seedance-1-pro-fast
# (also runpod/i2v_wan22_5b, runpod/i2v_ltx2). Not in the shipped chain:
# name it here once your endpoint is deployed. Both ids come from the RunPod
# console (Settings -> API Keys, restricted to Serverless; Serverless -> the
# endpoint's ID). The GPU price is optional: the flex price of the endpoint's
# GPU tier (RTX 5090 1.58, L40S 1.75, RTX 4090 1.10 on 2026-10-06), used only
# to log what RunPod really billed next to the table's estimate.
RUNPOD_API_KEY=
RUNPOD_COMFY_ENDPOINT_ID=
RUNPOD_GPU_USD_PER_HOUR=

# The story MCP server (mcp_server/, docs/MCP.md): Claude as the writer and
# director, this backend as its tools. A second RunPod endpoint for images
# (FLUX.2 klein) on the same volume, so a worker never swaps video weights for
# image weights; empty = images go to RUNPOD_COMFY_ENDPOINT_ID. Its GPU price
# is optional, like the video one's; RUNPOD_IMAGE_API_KEY too (a key of its
# own for that endpoint, else RUNPOD_API_KEY opens both). MCP_HOST/MCP_PORT: where
# `python -m mcp_server` listens (127.0.0.1:8787; put Tailscale Funnel or a
# reverse proxy in front). MCP_TOKEN: the bearer token a client must send
# (empty = no auth, local use only). MCP_PUBLIC_URL: the address clients reach
# the server at (the Funnel URL, https://<node>.<tailnet>.ts.net); set, the
# server is also an OAuth authorization server for the claude.ai connector,
# whose login page asks for MCP_TOKEN (docs/MCP.md).
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_IMAGE_API_KEY=
RUNPOD_IMAGE_GPU_USD_PER_HOUR=
MCP_HOST=
MCP_PORT=
MCP_TOKEN=
MCP_PUBLIC_URL=

# --- AI Story budget (DEC-097) ---

# Paid generation providers are never called unless this is 1. Same as
# --allow-paid, or the "Allow paid providers" toggle in Settings -> Budget.
ALLOW_PAID=

# Caps in USD, checked before every paid call; a refusal shows the numbers.
# Empty = the defaults: 1.00 per episode, 3.00 per budget day (BUDGET_TIMEZONE below), 10.00 per story.
PER_EPISODE_CAP_USD=
DAILY_CAP_USD=
PER_STORY_CAP_USD=

# free | one_dollar | quality. Empty = free until ALLOW_PAID is on, then
# one_dollar (spec 8.5). The profile decides where money goes; the caps decide
# whether it is spent.
BUDGET_PROFILE=

# The zone of the daily cap's day: an IANA name such as Europe/Paris, so the
# day resets at your midnight. Empty = UTC. The free-tier counters stay on the
# UTC day (the providers reset their own quotas at 00:00 UTC).
BUDGET_TIMEZONE=

# --- Facebook Pages Reels uploader (run_fb_upload.py) ---------------------
# Optional; nothing else reads these. The last two have defaults in code, so
# uncomment them only to change the value -- an empty `NAME=` line would
# replace the default with nothing.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v25.0
# APP_TIMEZONE=Asia/Makassar

# --- Runtime --------------------------------------------------------------
MAX_CONCURRENT_JOBS=1
# How many jobs may WAIT for a worker; past it a new job gets 429. 0 = no limit.
MAX_QUEUED_JOBS=20

# --- Downloading from a URL ------------------------------------------------
# The server will try to download a job's `source_url` itself. This is
# best-effort on purpose: sites score a request by the IP's reputation before
# anything else, and this machine is in a datacenter range, so a large share of
# attempts are refused however the request is dressed up. A refusal parks the
# job in `needs_upload` with instructions rather than failing it.
#
# The reliable path is tools/rzclips-fetch.py, run on a machine with a home
# connection. See docs/deploy-tailscale.md for the API token it needs.
ENABLE_SERVER_FETCH=1

# Optional proof-of-origin token provider. Its own authors say it "may help your
# traffic seem more legitimate" -- it is not a bypass.
#   docker compose --profile pot up -d
#   POT_PROVIDER_URL=http://bgutil:4416
POT_PROVIDER_URL=

# Optional: a Netscape-format cookies.txt at data/cookies.txt is passed to
# yt-dlp when present. Cookies expire faster when used from a datacenter IP.

# --- Serving ---------------------------------------------------------------
# Auth is opt-in. Set API_TOKEN to require it on every request; left empty,
# the API is open to whoever can reach the port -- keep it on localhost or a
# private tailnet. Required when DOMAIN below is set.
API_TOKEN=

# Shown in the startup banner, e.g. https://your-machine.your-tailnet.ts.net
PUBLIC_URL=

# Only for the `domain` compose profile (Caddy), which puts the API on the
# public internet -- the backend refuses to start unless API_TOKEN is set too.
DOMAIN=
ACME_EMAIL=
