# Copy to .env and fill in what you need:  cp .env.example .env

# --- Container user -------------------------------------------------------
# docker-compose bind-mounts ./uploads and ./outputs into the backend. A bind
# mount keeps the HOST's ownership, so the container must run as the user that
# owns those directories or every upload fails with
#   PermissionError: [Errno 13] Permission denied: '/app/uploads/<file>'
# Defaults to 1000:1000, which is correct for the first user on most Linux
# distributions. Check yours with `id -u` and `id -g`.
DOCKER_UID=1000
DOCKER_GID=1000

# --- AI providers ---------------------------------------------------------
# The analysis talks to free, OpenAI-compatible endpoints through an ordered
# CHAIN. Each link is "<provider>/<model>", tried in order; every hop is
# printed, a link whose key is missing is skipped with a line saying so, and a
# provider that is not named here is never contacted.
#
# Leave LLM_CHAIN empty to use the shipped default:
#   groq/openai/gpt-oss-120b,gemini/gemini-3.5-flash-lite,openrouter/mistralai/mistral-small-3.2-24b-instruct,mistral/mistral-small-latest,nvidia/nvidia/nemotron-3.5-lightning-30b-a3b
# Groq first because it is by far the fastest free tier, Gemini second because
# its daily request budget is the largest, OpenRouter third because it is paid
# (so it is only spent when both free tiers failed), Mistral fourth, NVIDIA
# last because it has no published daily cap. A link with no key is skipped.
#
# Measure before you choose: python tools/bench_llm.py
LLM_CHAIN=

# Provider keys. The default chain uses Groq, Gemini, OpenRouter, Mistral,
# then NVIDIA.
#
# SET AT LEAST ONE OF GROQ, GEMINI, OPENROUTER OR MISTRAL. They are the chain's
# primary links; all but OpenRouter are free. NVIDIA is its floor: ~12
# tokens/s behind a queue that can hold a request for a minute, so a job whose
# only key is NVIDIA's is refused before it starts (see ALLOW_SLOW_CHAIN below).
#
# https://console.groq.com/keys   — also powers hosted transcription.
GROQ_API_KEY=

# https://aistudio.google.com/apikey — also needed for --voiceover.
GOOGLE_API_KEY=

# https://build.nvidia.com/ — NVIDIA NIM. A backup, not a primary.
NVIDIA_API_KEY=

# Run a job anyway when NVIDIA is the only keyed link. Same as
# --allow-slow-chain, or the "Run on the slow chain anyway" toggle in Settings.
# Expect the analysis to take tens of minutes and to skip windows when the time
# budget runs out. 1 to enable; leave empty otherwise.
ALLOW_SLOW_CHAIN=

# https://openrouter.ai/keys — PAID: the default model is
# mistralai/mistral-small-3.2-24b-instruct, a few tenths of a cent per job.
# Its ":free" models were measured unable to do the analysis (2026-09-24).
OPENROUTER_API_KEY=

# https://console.mistral.ai/ — free "Experiment" tier; also Voxtral transcription.
MISTRAL_API_KEY=

# Any other OpenAI-compatible endpoint, including a local one. Reachable in the
# chain as "custom/<model>".
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=

# [OPTIONAL] Any other OpenAI-compatible endpoint, used with
# `--ai-provider openai_compat`. Only worth setting if you already have a key
# somewhere else -- Groq and Gemini above are free.
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Mistral     https://api.mistral.ai/v1
#   xAI         https://api.x.ai/v1
#   Ollama      http://localhost:11434/v1   (key ignored, but must be non-empty)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional: B-roll footage for Clips mode. Sources are tried in BROLL_SOURCES
# order (default local,pexels,pixabay); one with no key or folder is skipped, so
# a Pexels key alone behaves as it always did. Clips that use stock footage carry
# its credit in render_manifest.json (`broll_credits`).
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ — free key, 100 requests per minute.
PIXABAY_API_KEY=
# Your own clips (mp4/mov/webm): the folder must be ./broll (/app/broll in the
# container). Leave both empty to keep the defaults.
#   BROLL_SOURCES=local,pexels,pixabay
#   BROLL_LOCAL_DIR=/app/broll

# Optional: required only for diarization (split-screen / camera-switch).
# Also needs the pyannote model licence accepted on HuggingFace.
HF_TOKEN=

# --- Paid LLM links (optional) ---------------------------------------------
# https://aistudio.google.com/apikey — PAID: the "gemini-paid" provider, a key
# from a SEPARATE Google project with billing enabled, so a paid call is never
# billed to GOOGLE_API_KEY's project. Used only by a gemini-paid/<model> link.
GEMINI_PAID_API_KEY=
# https://platform.claude.com/settings/keys — PAID per request: Claude on the
# Anthropic API, for anthropic/<model> links of LLM_CHAIN (an effort may follow
# as @low|@medium|@high|@xhigh). The Settings check is free (a model lookup).
ANTHROPIC_API_KEY=

# --- showrunner MCP server (AI stories; docs/MCP.md) ------------------------
# RunPod Serverless ComfyUI: the video endpoint (LTX-2.5 clips, Chatterbox
# voice conversion) and the image endpoint (FLUX.2 klein), on one network
# volume (showrunner/worker/ENDPOINT.md). Billed per GPU second; idle costs
# nothing. RUNPOD_API_KEY opens both unless an endpoint has a key of its own.
RUNPOD_API_KEY=
RUNPOD_SHOWRUNNER_VIDEO_ENDPOINT_ID=
RUNPOD_SHOWRUNNER_VIDEO_KEY=
RUNPOD_IMAGE_ENDPOINT_ID=
RUNPOD_IMAGE_API_KEY=
# An older endpoint the showrunner must never send to: read only to refuse it.
RUNPOD_COMFY_ENDPOINT_ID=
# The bearer token a client sends, and what its claude.ai login page asks;
# empty = no auth, local use only.
MCP_TOKEN=

# --- Facebook Pages Reels uploader (run_fb_upload.py) ---------------------
# Optional; nothing else reads these. The last two have defaults in code, so
# uncomment them only to change the value -- an empty `NAME=` line would
# replace the default with nothing.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v25.0
# APP_TIMEZONE=Asia/Makassar

# --- Runtime --------------------------------------------------------------
MAX_CONCURRENT_JOBS=1
# How many jobs may WAIT for a worker; past it a new job gets 429. 0 = no limit.
MAX_QUEUED_JOBS=20

# --- Downloading from a URL ------------------------------------------------
# The server will try to download a job's `source_url` itself. This is
# best-effort on purpose: sites score a request by the IP's reputation before
# anything else, and this machine is in a datacenter range, so a large share of
# attempts are refused however the request is dressed up. A refusal parks the
# job in `needs_upload` with instructions rather than failing it.
#
# The reliable path is tools/rzclips-fetch.py, run on a machine with a home
# connection. See docs/deploy-tailscale.md for the API token it needs.
ENABLE_SERVER_FETCH=1

# Optional proof-of-origin token provider. Its own authors say it "may help your
# traffic seem more legitimate" -- it is not a bypass.
#   docker compose --profile pot up -d
#   POT_PROVIDER_URL=http://bgutil:4416
POT_PROVIDER_URL=

# Optional: a Netscape-format cookies.txt at data/cookies.txt is passed to
# yt-dlp when present. Cookies expire faster when used from a datacenter IP.

# --- Serving ---------------------------------------------------------------
# Auth is opt-in. Set API_TOKEN to require it on every request; left empty,
# the API is open to whoever can reach the port -- keep it on localhost or a
# private tailnet. Required when DOMAIN below is set.
API_TOKEN=

# Shown in the startup banner, e.g. https://your-machine.your-tailnet.ts.net
PUBLIC_URL=

# Only for the `domain` compose profile (Caddy), which puts the API on the
# public internet -- the backend refuses to start unless API_TOKEN is set too.
DOMAIN=
ACME_EMAIL=

# Where the showrunner MCP server listens (docs/MCP.md). MCP_TOKEN (above) is its secret.
SHOWRUNNER_MCP_HOST=127.0.0.1
SHOWRUNNER_MCP_PORT=8787
SHOWRUNNER_MCP_PUBLIC_URL=
# SHOWRUNNER_STORIES_DIR=stories
# SHOWRUNNER_STT_MODEL=large-v3
